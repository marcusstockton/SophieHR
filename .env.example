# Copy this file to .env and fill in real values. Do NOT commit the .env file to source control.

# Optional registry prefix for image names (e.g. myregistry.azurecr.io/)
DOCKER_REGISTRY=

# Database
POSTGRES_PASSWORD=ChangeMeStrongPassword!
POSTGRES_USER=postgres
POSTGRES_DB=SophieHR
# Connection string used by the API. Keep the password in sync with POSTGRES_PASSWORD.
# Example format for the appsettings style used in the compose file
ConnectionStrings__DefaultConnection=Host=sophiehr-db;Port=5432;Database=SophieHR;Username=postgres;Password=ChangeMeStrongPassword!

# HERE Maps API key (if used)
HERE_Maps_API_Key=

# Grafana admin password
GRAFANA_PASSWORD=admin

# Other developer flags
# Enable Docker buildkit if you use it locally
DOCKER_BUILDKIT=1

# Notes:
# - After filling this file, rename to .env and keep it out of version control (add .env to .gitignore).
# - For production, consider using Docker secrets or a secrets manager instead of a plain .env file.
